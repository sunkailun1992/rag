# Java 门面和引擎共享的内部 Bearer 密钥，至少 32 字符；部署时从私有配置注入。
RAG_ENGINE_API_KEY=
# Qdrant HTTP 根地址；空值时解析仍可用，检索返回 RETRIEVAL_NOT_CONFIGURED。
RAG_ENGINE_QDRANT_URL=
# Qdrant API key；仅在目标服务开启鉴权时必填。
RAG_ENGINE_QDRANT_API_KEY=
# 必须与 Java rag.vector.collection-name 完全一致，不能误用公司 collection。
RAG_ENGINE_COLLECTION=knowledge-vectors
# 千问 OpenAI 兼容根地址，包含 /compatible-mode/v1；rerank 自动使用 compatible-api。
RAG_ENGINE_QWEN_BASE_URL=
# 模型私钥从 Nacos 私有渲染或宿主机秘密注入，不提交 .env。
RAG_ENGINE_QWEN_API_KEY=
# 必须与 Java 摄取侧模型一致；修改模型必须重新评估整个 collection。
RAG_ENGINE_EMBEDDING_MODEL=text-embedding-v4
# 必须与 Java 和现存 Qdrant 向量维度一致。
RAG_ENGINE_EMBEDDING_DIMENSION=1024
# 候选重排模型；失败/超时回退本次向量排序并标记 degraded。
RAG_ENGINE_RERANK_MODEL=qwen3-rerank
# 成功重排后的最低相关性，0..1，默认0.5；低分返回空，不适用于 dense/RRF 降级分数。
RAG_ENGINE_RERANK_SCORE_THRESHOLD=0.5
# 默认 dense；仅在 lexical-v1 schema、完整回填、Java 双写都验收后开启真实双路/RRF。
RAG_ENGINE_HYBRID_ENABLED=false
# PaddleOCR 官方 layout-parsing 服务根地址；空值禁用扫描件/图片，不影响文字型 PDF。
RAG_ENGINE_OCR_URL=
# OCR 网关可选 Bearer 密钥；空值不发送认证头。
RAG_ENGINE_OCR_API_KEY=
# 总检索预算（秒），上限 3；Java 设置 3500ms，ai 调用链 5 秒。
RAG_ENGINE_RETRIEVAL_TIMEOUT_SECONDS=3
# 重排预算（秒），包含在总预算内；超时允许向量排序降级。
RAG_ENGINE_RERANK_TIMEOUT_SECONDS=0.8
# 上传文件字节上限，最大 20 MiB。
RAG_ENGINE_MAX_FILE_BYTES=20971520
# 单文档 PDF 页数上限，超限整份拒绝，不静默截断。
RAG_ENGINE_MAX_PAGES=100
# 原文解码字符数上限，超限整份拒绝。
RAG_ENGINE_MAX_TEXT_CHARACTERS=2000000
# 切片总量上限，超限整份拒绝。
RAG_ENGINE_MAX_CHUNKS=1000
# 解析总预算（秒）；Java 解析超时应略大于此值。
RAG_ENGINE_PARSE_TIMEOUT_SECONDS=55
# NAS 默认只允许一个解析请求，超出返回 429，避免排队耗尽内存。
RAG_ENGINE_PARSE_WORKERS=1
# 上游 JSON 响应字节上限，避免 OCR 返回大图导致内存增长。
RAG_ENGINE_MAX_UPSTREAM_BYTES=16777216
