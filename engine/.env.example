# Java 门面和引擎共享的内部 Bearer 密钥，至少 32 字符；部署时从私有配置注入。
RAG_ENGINE_API_KEY=
# NAS Compose 的宿主端口，默认 18091，避开 Seata 的 8091；不改变容器内部 8091。
RAG_ENGINE_HOST_PORT=18091
# Qdrant HTTP 根地址；空值时解析仍可用，检索返回 RETRIEVAL_NOT_CONFIGURED。
RAG_ENGINE_QDRANT_URL=
# Qdrant API key；仅在目标服务开启鉴权时必填。
RAG_ENGINE_QDRANT_API_KEY=
# 必须与 Java rag.vector.collection-name 完全一致，不能误用公司 collection。
RAG_ENGINE_COLLECTION=knowledge-vectors
# 千问 OpenAI 兼容根地址，包含 /compatible-mode/v1；rerank 自动使用 compatible-api。
RAG_ENGINE_QWEN_BASE_URL=
# 模型私钥从 Nacos 私有渲染或宿主机秘密注入，不提交 .env。
RAG_ENGINE_QWEN_API_KEY=
# 必须与 Java 摄取侧模型一致；修改模型必须重新评估整个 collection。
RAG_ENGINE_EMBEDDING_MODEL=text-embedding-v4
# 必须与 Java 和现存 Qdrant 向量维度一致。
RAG_ENGINE_EMBEDDING_DIMENSION=1024
# 候选重排模型；失败/超时回退本次向量排序并标记 degraded。
RAG_ENGINE_RERANK_MODEL=qwen3-rerank
# 成功重排后的最低相关性，0..1，默认0.5；低分返回空，不适用于 dense/RRF 降级分数。
RAG_ENGINE_RERANK_SCORE_THRESHOLD=0.5
# 默认 dense；仅在 lexical-v1 schema、完整回填、Java 双写都验收后开启真实双路/RRF。
RAG_ENGINE_HYBRID_ENABLED=false
# PaddleOCR 官方 layout-parsing 服务根地址；空值禁用扫描件/图片，不影响文字型 PDF。
RAG_ENGINE_OCR_URL=
# OCR 网关可选 Bearer 密钥；空值不发送认证头。
RAG_ENGINE_OCR_API_KEY=
# 总检索预算（秒），上限 3；Java 设置 3500ms，ai 调用链 5 秒。
RAG_ENGINE_RETRIEVAL_TIMEOUT_SECONDS=3
# 重排预算（秒），包含在总预算内；超时允许向量排序降级。
RAG_ENGINE_RERANK_TIMEOUT_SECONDS=0.8
# 上传文件字节上限，最大 20 MiB。
RAG_ENGINE_MAX_FILE_BYTES=20971520
# 单文档 PDF 页数上限，超限整份拒绝，不静默截断。
RAG_ENGINE_MAX_PAGES=100
# 原文解码字符数上限，超限整份拒绝。
RAG_ENGINE_MAX_TEXT_CHARACTERS=2000000
# 切片总量上限，超限整份拒绝。
RAG_ENGINE_MAX_CHUNKS=1000
# 解析总预算（秒）；Java 解析超时应略大于此值。
RAG_ENGINE_PARSE_TIMEOUT_SECONDS=55
# NAS 默认只允许一个解析请求，超出返回 429，避免排队耗尽内存。
RAG_ENGINE_PARSE_WORKERS=1
# 上游 JSON 响应字节上限，避免 OCR 返回大图导致内存增长。
RAG_ENGINE_MAX_UPSTREAM_BYTES=16777216
# 图派生索引默认关闭；开启需独立完成 Neo4j/APOC、模型与来源生命周期验收。
RAG_ENGINE_GRAPH_ENABLED=false
# 图关联候选扩展独立关闭；开启后最多0.4秒（仍包含在原3秒检索预算），必须Qdrant回读+rerank。
RAG_ENGINE_GRAPH_RETRIEVAL_ENABLED=false
# Neo4j Bolt/Neo4j URI；仅私有环境注入，不允许 URI 中包含用户名/密码。
RAG_ENGINE_NEO4J_URL=
# 具有本服务图读写权限的数据库用户；密码只从 Git 外注入。
RAG_ENGINE_NEO4J_USERNAME=neo4j
RAG_ENGINE_NEO4J_PASSWORD=
# Community 使用既有 neo4j 数据库，通过 tenant/KB/来源身份隔离。
RAG_ENGINE_NEO4J_DATABASE=neo4j
# 抽取用支持严格 JSON Schema 的千问 Chat Completions 快照；独立于 embedding/rerank，关闭 thinking。
RAG_ENGINE_GRAPH_MODEL=qwen3.7-plus-2026-05-26
# 单任务内的模型抽取请求并发数（1–4），缺省1；HTTP连接同步限流，仍只有一个构建worker。
# 增加前按语料实测模型限流、RSS和构建预算，不能据此增加容器CPU或内存上限。
RAG_ENGINE_GRAPH_EXTRACTION_WORKERS=1
# 全局单图 worker，最多等待任务数；队列满明确返回 429，不撤销活动向量。
RAG_ENGINE_GRAPH_QUEUE_SIZE=2
# 从入队到完成的总预算（秒），含排队、抽取、回读和发布；超时杀进程并拒绝发布。
RAG_ENGINE_GRAPH_BUILD_TIMEOUT_SECONDS=300
# 图查询/提交请求及控制面 Neo4j 事务预算（秒），不用于构建子进程的批量存储。
RAG_ENGINE_GRAPH_QUERY_TIMEOUT_SECONDS=3
# 构建子进程批量写库、去重查及持久化读回的单事务预算（秒，1–60）；整次构建仍受总deadline约束。
# 缺省30秒，不增加CPU/内存，也不延长交互查询；原128条分批写入和失败不发布保持。
RAG_ENGINE_GRAPH_STORAGE_TIMEOUT_SECONDS=30
# 单次模型请求总预算（秒）；每个切片的传输恢复、局部纠正与完整重抽共用最多三次请求，仍受构建总deadline限制。
# 仅固定临时传输错误在共享三次预算内恢复，永久错误立即失败；不忽略坏三元组、不以空图掩盖抽取失败。
RAG_ENGINE_GRAPH_LLM_TIMEOUT_SECONDS=20
# 每个 chunk 的关系硬上限；超过整次任务失败，不截断模型输出伪装完成。
RAG_ENGINE_GRAPH_MAX_TRIPLETS_PER_CHUNK=12
# 展示关系上限；节点始终最多 500，每个节点/边最多返回8个来源。
RAG_ENGINE_GRAPH_MAX_EDGES=2000
# 全局图 worker 租约（秒）；单 Uvicorn worker，其他实例不夺取有效租约。
RAG_ENGINE_GRAPH_LEASE_SECONDS=30
